   "source": [
    "# key를 활용한 정렬\n",
    "array = [('바나나', 2), ('사과', 5), ('당근', 3)]\n",
    "\n",
    "def setting(data):\n",
    "    return data[1]\n",
    "\n",
    "result = sorted(array, key = setting) # setting 함수의 리턴값 기준으로 정렬 \n",
    "print(result)"
   ]
  }
 ],
